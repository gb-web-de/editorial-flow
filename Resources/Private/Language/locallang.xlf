            <trans-unit id="membership.error.server" xml:space="preserve">
                <source>Could not reach the server. (CF-1042)</source>
            </trans-unit>
            <trans-unit id="membership.error.targetsFailed" xml:space="preserve">
                <source>The tasks this record could move to could not be loaded. (CF-1043)</source>
            </trans-unit>

            <!--
                The comment TaskAutoCreationService writes when an edit drags a
                task back out of review. Its Visual Editor counterpart is
                `ve.comment.reopened` above - both are editor-facing history, so
                neither belongs in a PHP string literal.
                %1$s is the table, %2$d the record uid.
            -->
            <trans-unit id="autoCreation.comment.reopened" xml:space="preserve">
                <source>Automatically reopened for editing - %1$s:%2$d was modified.</source>
            </trans-unit>

            <!--
                Cross-workspace conflict badge, shown on the Page module banner,
                the content-element badge, the board card and the ticket when
                the same live record has a pending version in more than one
                workspace at once. WorkspaceConflictDetector detects it,
                nothing publishes without a human choosing to.
            -->
            <trans-unit id="conflict.badge" xml:space="preserve">
                <source>conflict</source>
            </trans-unit>
            <trans-unit id="conflict.banner" xml:space="preserve">
                <source>Also edited in %1$s</source>
            </trans-unit>
            <trans-unit id="conflict.title" xml:space="preserve">
                <source>This record was also edited in another workspace - compare before publishing either side.</source>
            </trans-unit>
            <trans-unit id="conflict.view" xml:space="preserve">
                <source>Compare versions</source>
            </trans-unit>
            <trans-unit id="conflict.diff.heading" xml:space="preserve">
                <source>Workspace comparison</source>
            </trans-unit>
            <trans-unit id="conflict.diff.field" xml:space="preserve">
                <source>Field</source>
            </trans-unit>
            <trans-unit id="conflict.diff.live" xml:space="preserve">
                <source>Live</source>
            </trans-unit>
            <trans-unit id="conflict.diff.trueConflict" xml:space="preserve">
                <source>conflicting</source>
            </trans-unit>
            <trans-unit id="conflict.diff.empty" xml:space="preserve">
                <source>No conflict (any more) for this record.</source>
            </trans-unit>
            <trans-unit id="conflict.diff.invalid" xml:space="preserve">
                <source>Invalid record.</source>
            </trans-unit>
            <trans-unit id="widget.group.editorialFlow" xml:space="preserve">
                <source>Editorial Flow</source>
            </trans-unit>
            <trans-unit id="close.trigger" xml:space="preserve">
                <source>Close</source>
            </trans-unit>
            <trans-unit id="close.trigger.title" xml:space="preserve">
                <source>Close this task</source>
            </trans-unit>
            <trans-unit id="close.dialog.title" xml:space="preserve">
                <source>Close "%s"?</source>
            </trans-unit>
            <trans-unit id="close.dialog.nothingPending" xml:space="preserve">
                <source>This task has nothing pending. Closing it moves it to Done.</source>
            </trans-unit>
            <trans-unit id="close.dialog.pendingIntro" xml:space="preserve">
                <source>%s still has unpublished changes in workspace "%s":</source>
            </trans-unit>
            <trans-unit id="close.dialog.moreChanges" xml:space="preserve">
                <source>and %s more</source>
            </trans-unit>
            <trans-unit id="close.dialog.legend" xml:space="preserve">
                <source>What should happen to these changes?</source>
            </trans-unit>
            <trans-unit id="close.dialog.keep" xml:space="preserve">
                <source>Close the task and leave these changes pending</source>
            </trans-unit>
            <trans-unit id="close.dialog.keepHint" xml:space="preserve">
                <source>They stay in the workspace and remain reachable from the Workspaces module.</source>
            </trans-unit>
            <trans-unit id="close.dialog.handover" xml:space="preserve">
                <source>Hand these records to another task first</source>
            </trans-unit>
            <trans-unit id="close.dialog.handoverNone" xml:space="preserve">
                <source>No other open task on this page to hand them to.</source>
            </trans-unit>
            <trans-unit id="close.dialog.discard" xml:space="preserve">
                <source>Discard these changes and close</source>
            </trans-unit>
            <trans-unit id="close.dialog.discardWarning" xml:space="preserve">
                <source>This throws the unpublished work away. It cannot be undone.</source>
            </trans-unit>
            <trans-unit id="close.dialog.confirm" xml:space="preserve">
                <source>Close task</source>
            </trans-unit>
            <trans-unit id="close.dialog.cancel" xml:space="preserve">
                <source>Cancel</source>
            </trans-unit>
            <trans-unit id="close.success" xml:space="preserve">
                <source>%s closed.</source>
            </trans-unit>
            <trans-unit id="close.success.discarded" xml:space="preserve">
                <source>%s closed, %s change(s) discarded.</source>
            </trans-unit>
            <trans-unit id="close.error.failed" xml:space="preserve">
                <source>Could not close that task.</source>
            </trans-unit>
            <trans-unit id="close.error.server" xml:space="preserve">
                <source>Server error while closing the task.</source>
            </trans-unit>
            <trans-unit id="close.error.preview" xml:space="preserve">
                <source>Could not read what this task still has pending.</source>
            </trans-unit>
            <trans-unit id="ticket.nothingPending" xml:space="preserve">
                <source>Nothing is pending on this task in its workspace. Any work done here has since been discarded, or published from somewhere else - so there is nothing left to publish or move to another stage. Closing the task is what clears it.</source>
            </trans-unit>
            <trans-unit id="active.start.title" xml:space="preserve">
                <source>Your edits on this page will belong to this task</source>
            </trans-unit>
            <trans-unit id="active.start.liveTitle" xml:space="preserve">
                <source>Switch into a workspace first - edits made in Live are not tracked by Editorial Flow.</source>
            </trans-unit>
            <trans-unit id="badge.onPageOnly" xml:space="preserve">
                <source>on this page, not edited yet</source>
            </trans-unit>

            <!-- A stage's acceptance criteria, configured on the sys_workspace_stage
                 record (Configuration/TCA/Overrides/sys_workspace_stage.php) and asked
                 for again in the task before it leaves that stage. -->
            <trans-unit id="criteria.table" xml:space="preserve">
                <source>Acceptance criterion</source>
            </trans-unit>
            <trans-unit id="criteria.field" xml:space="preserve">
                <source>Acceptance criteria</source>
            </trans-unit>
            <trans-unit id="criteria.field.description" xml:space="preserve">
                <source>Editors are asked to confirm these before a task leaves this stage. Leaving one unchecked never blocks the move, but it has to be acknowledged and is written into the task's history.</source>
            </trans-unit>
            <trans-unit id="criteria.item.title" xml:space="preserve">
                <source>Criterion</source>
            </trans-unit>
            <trans-unit id="criteria.item.title.description" xml:space="preserve">
                <source>Phrase it as something an editor can confirm, for example "All links checked".</source>
            </trans-unit>
            <trans-unit id="criteria.new" xml:space="preserve">
                <source>Add acceptance criterion</source>
            </trans-unit>

            <!-- Asked in the "Send to stage" dialog and, when something is left
                 open, confirmed once before the move goes through. %1$d is the
                 number left unconfirmed, %2$d the total, %3$s the stage's title. -->
            <trans-unit id="criteria.incomplete.message" xml:space="preserve">
                <source>%1$d of %2$d acceptance criteria for "%3$s" are not confirmed.</source>
            </trans-unit>
            <!-- The acceptance record written into the task's history when it
                 leaves a stage that asked for criteria. %1$s is the stage title. -->
            <trans-unit id="criteria.record.heading" xml:space="preserve">
                <source>Acceptance criteria for "%1$s":</source>
            </trans-unit>
            <trans-unit id="criteria.record.allConfirmed" xml:space="preserve">
                <source>All criteria confirmed.</source>
            </trans-unit>
            <trans-unit id="criteria.record.acknowledged" xml:space="preserve">
                <source>Sent on with %1$d of %2$d criteria left unconfirmed.</source>
            </trans-unit>
            <trans-unit id="criteria.dialog.heading" xml:space="preserve">
                <source>Acceptance criteria</source>
            </trans-unit>
            <trans-unit id="criteria.dialog.hint" xml:space="preserve">
                <source>Confirm what this stage asks for. Each tick is saved immediately and recorded in the task's history.</source>
            </trans-unit>
            <trans-unit id="criteria.dialog.error" xml:space="preserve">
                <source>Could not record that criterion.</source>
            </trans-unit>
            <trans-unit id="criteria.confirm.title" xml:space="preserve">
                <source>Unconfirmed acceptance criteria</source>
            </trans-unit>
            <trans-unit id="criteria.confirm.send" xml:space="preserve">
                <source>Send anyway</source>
            </trans-unit>
            <trans-unit id="criteria.confirm.back" xml:space="preserve">
                <source>Back to the criteria</source>
            </trans-unit>

            <!-- Shown in Administration > Integrations > Webhooks when an
                 administrator picks what a webhook should react to. -->
            <trans-unit id="webhook.taskCreated" xml:space="preserve">
                <source>Editorial Flow: a task was created</source>
            </trans-unit>
            <trans-unit id="webhook.taskStageChanged" xml:space="preserve">
                <source>Editorial Flow: a task moved to another stage</source>
            </trans-unit>
            <trans-unit id="webhook.taskClosed" xml:space="preserve">
                <source>Editorial Flow: a task was closed</source>
            </trans-unit>
