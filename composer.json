{
    "name": "gb-web/editorial-flow",
    "type": "typo3-cms-extension",
    "description": "Editorial Flow - Editorial task board for TYPO3: a backlog in front of TYPO3 workspaces, with tasks that open themselves when editors start working.",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Gordon Brueggemann",
            "email": "gordon.brueggemann@gb-web.de",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/gb-web/editorial-flow/issues",
        "source": "https://github.com/gb-web/editorial-flow"
    },
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "friendsoftypo3/visual-editor": "^1.9",
        "typo3/cms-backend": "^14.3",
        "typo3/cms-core": "^14.3",
        "typo3/cms-dashboard": "^14.3",
        "typo3/cms-extbase": "^14.3",
        "typo3/cms-fluid": "^14.3",
        "typo3/cms-workspaces": "^14.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95.1",
        "phpstan/phpstan": "^2.1.54",
        "phpstan/phpstan-phpunit": "^2.0.16",
        "phpunit/phpunit": "^11.5.55",
        "saschaegerer/phpstan-typo3": "^3.0.1",
        "typo3/cms-fluid-styled-content": "^14.3",
        "typo3/cms-impexp": "^14.3",
        "typo3/cms-install": "^14.3",
        "typo3/cms-lowlevel": "^14.3",
        "typo3/cms-reactions": "^14.3",
        "typo3/cms-rte-ckeditor": "^14.3",
        "typo3/cms-scheduler": "^14.3",
        "typo3/cms-setup": "^14.3",
        "typo3/cms-styleguide": "^14.0",
        "typo3/cms-webhooks": "^14.3",
        "typo3/testing-framework": "^9.5",
        "typo3/theme-camino": "^14.3"
    },
    "suggest": {
        "typo3/cms-webhooks": "Sends task events (created, stage changed, closed) to external systems such as Jira or Trello. The message types are always present - they need nothing but typo3/cms-core - and become configurable in Administration > Integrations > Webhooks as soon as this is installed.",
        "typo3/cms-reactions": "Accepts task updates from external systems through an incoming webhook. Required for GbWeb\\EditorialFlow\\Reaction\\TaskReaction, which is registered only when this is installed."
    },
    "autoload": {
        "psr-4": {
            "GbWeb\\EditorialFlow\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GbWeb\\EditorialFlow\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "editorial_flow",
            "web-dir": ".Build/Web",
            "app-dir": ".Build",
            "version": "0.0.1-dev",
            "Package": {
                "providesPackages": []
            }
        }
    },
    "config": {
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin",
        "sort-packages": true,
        "optimize-autoloader": true,
        "lock": false,
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    },
    "minimum-stability": "stable",
    "scripts": {
        "cs:check": "${PHP_BINARY} .Build/bin/php-cs-fixer fix --config Build/php-cs-fixer/php-cs-rules.php --diff --dry-run",
        "cs:fix": "${PHP_BINARY} .Build/bin/php-cs-fixer fix --config Build/php-cs-fixer/php-cs-rules.php",
        "phpstan": "${PHP_BINARY} .Build/bin/phpstan analyse -c Build/phpstan/phpstan.neon --no-progress",
        "test:unit": "${PHP_BINARY} .Build/bin/phpunit -c Build/phpunit/UnitTests.xml",
        "test:functional": "${PHP_BINARY} .Build/bin/phpunit -c Build/phpunit/FunctionalTests.xml"
    }
}
